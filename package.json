{
  "name": "quickfill-extension",
  "version": "1.0",
  "private": true,
  "type": "module",
  "description": "User-centric job-application auto-fill Chrome extension.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,svelte,css,html,json}\""
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "fuse.js": "^7.0.0",
    "mammoth": "^1.8.0",
    "svelte": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@playwright/test": "^1.47.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@testing-library/svelte": "^5.2.0",
    "@types/chrome": "^0.0.270",
    "@types/node": "^22.5.4",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.6",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
